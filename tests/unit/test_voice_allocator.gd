extends RefCounted

func run(t) -> void:
	var allocator = VoiceAllocator.new()
	t.check(allocator.snapshot().size() == 8, "allocator preallocates exactly8 voice slots")
	if allocator.snapshot().size() != 8: return
	t.check(allocator.active_count() == 0, "all voices begin free")
	t.check(allocator.claim_level(0, 7) == 0 and allocator.claim_level(1, 7) == -1, "level exclusively claims slot0")
	t.check(allocator.request("hit", 0, 7) == 1, "free shared slot uses smallest index")
	t.check(allocator.request("hit", 2, 7) == -1, "hit merged inside independent3tick window")
	t.check(allocator.request("kill", 1, 7) == 2, "kill window independent of hit")
	t.check(allocator.request("hit", 3, 7) == 3, "dropped hit does not extend actualstart window")
	allocator.reset()
	t.check(allocator.request("attack_arc", 0, 7) == 1 and allocator.request("attack_arc", 3, 7) == -1, "attack has4tick window")
	t.check(allocator.request("attack_arc", 0, 7, true) == 2 and allocator.request("attack_straight", 0, 7) == 3, "attack merge grouping separates role andmode")
	allocator.reset()
	for index in 7: t.check(allocator.request("hit", index * 3, 7) == index + 1, "fill sharedslots")
	t.check(allocator.request("attack_arc", 30, 7) == -1, "low priority dropped withoutqueue")
	t.check(allocator.request("kill", 30, 7) == 1 and allocator.stolen == 1, "strictly lower oldestserial is stolen")
	t.check(allocator.claim_level(31,7) == 0 and allocator.active_count() == 8, "busy/paused voices still count towards8")
	allocator.reset()
	for index in 7: allocator.request("hero_hurt", index, 7)
	t.check(allocator.request("hero_hurt", 20, 7) == 1, "hurt can replace oldest equalpriority hurt")
	t.check(allocator.request("kill", 30, 7) == -1, "kill cannot steal sameorhigher priority")
	var state = allocator.snapshot()
	t.check(state.is_read_only() and state[0].is_read_only(), "voice diagnostic snapshot read-only")
	allocator.release(1)
	t.check(allocator.active_count() == 6 and allocator.request("hit", 50, 7) == 1, "stop releases slot synchronously")
	allocator.reset()
	t.check(allocator.active_count() == 0 and allocator.accepted == 0 and allocator.cue_started.is_empty(), "reset clears voices and merge/diagnostic sessionstate")
