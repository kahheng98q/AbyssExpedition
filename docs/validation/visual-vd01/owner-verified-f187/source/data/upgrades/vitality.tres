amount = 1.0
[resource]
script = ExtResource("1")
id = &"vitality"
label = "Vitality"
description = "Maximum HP +10% of starting HP. Heal that increase."
max_stacks = 0
fallback = true
effects = Array[ExtResource("2")]([SubResource("effect"), SubResource("healing")])